#
# ASTRA — example local environment
#
# Copy to `.env` and edit. `.env` is gitignored and must stay that way.
#
# Every ASTRA_* variable overrides the corresponding configuration field, at
# higher precedence than both the packaged defaults and the environment file.
# Nesting uses a double underscore: ASTRA_<SECTION>__<FIELD>.
#
# Use these for local experimentation. Do NOT use them to supply a safety
# threshold for anything whose numbers will be reported: a value set in a
# developer's shell leaves no reviewable trace, whereas a value in
# `config/environments/*.toml` is committed, diffable and attributable. The
# configuration hash on every decision record changes either way, which is what
# makes the substitution detectable after the fact.
#

# Which environment file to layer on: development | simulation | certification
ASTRA_ENVIRONMENT=development

# --- Overrides (all optional; shown with their development values) ----------

# L1 — sensor staleness budget, milliseconds (FR1's 50 ms rule)
# ASTRA_SENSING__STALENESS_BUDGET_MS=50.0

# L2 — filter rates and the innovation-monitor Mahalanobis gate
# ASTRA_ESTIMATION__FAST_RATE_HZ=20.0
# ASTRA_ESTIMATION__SLOW_RATE_HZ=1.0
# ASTRA_ESTIMATION__INNOVATION_GATE_GAMMA=9.0

# L3 — conformal coverage
# ASTRA_TRUST__COVERAGE_LEVEL=0.95

# L6 — statistical gate
# ASTRA_GATE__SIGNIFICANCE_EPSILON=0.05
# ASTRA_GATE__MMD_THRESHOLD=0.10

# L7a — the hard bounds
# ASTRA_SHIELD__LEGAL_SPEED_LIMIT_KMH=50.0
# ASTRA_SHIELD__FRICTION_MARGIN=0.85

# L8 — fail-safe thresholds (must satisfy theta1 < theta2 < theta3)
# ASTRA_FAILSAFE__OOD_THRESHOLD_DEGRADED=3
# ASTRA_FAILSAFE__OOD_THRESHOLD_LIMP=6
# ASTRA_FAILSAFE__OOD_THRESHOLD_HALT=10

# L9 — arbitration
# ASTRA_ARBITRATION__TRUST_THRESHOLD_TAU=0.60
# ASTRA_ARBITRATION__DIVERGENCE_LIMIT_DELTA=0.25

# Observability
# ASTRA_OBSERVABILITY__LOG_LEVEL=DEBUG
# ASTRA_OBSERVABILITY__LOG_DIRECTORY=var/runs
