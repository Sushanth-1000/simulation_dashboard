# ASTRA — editor defaults, so formatting does not depend on who cloned the repo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 100 columns, matching `line-length` in pyproject.toml. Editors that render a
# ruler read this; ruff enforces it.
max_line_length = 100

[*.py]
indent_size = 4

[*.{toml,yaml,yml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is significant in Markdown (a hard line break).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
